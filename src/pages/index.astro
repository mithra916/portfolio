---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cyber Portfolio">

  <!-- NAVBAR -->
  <nav class="fixed top-0 left-0 w-full bg-black/70 backdrop-blur-md border-b border-purple-500/20 z-50">
    <div class="max-w-6xl mx-auto flex justify-between items-center px-6 py-4">
      <h1 class="text-purple-400 font-bold tracking-widest text-lg">
        CYBER
      </h1>

      <div class="space-x-6 text-sm">
        <a href="#home" class="hover:text-purple-400 transition">Home</a>
        <a href="#skills" class="hover:text-purple-400 transition">Skills</a>
        <a href="#projects" class="hover:text-purple-400 transition">Projects</a>
        <a href="#contact" class="hover:text-purple-400 transition">Contact</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section id="home" class="min-h-screen flex flex-col items-center justify-center text-center px-6 bg-gradient-to-b from-black via-gray-950 to-black pt-20">

    <h1 class="text-5xl md:text-7xl font-extrabold mb-6 
               text-purple-400
               drop-shadow-[0_0_30px_rgba(168,85,247,0.9)]">
      CYBER SECURITY
    </h1>

    <p class="text-gray-400 text-lg max-w-xl tracking-wide">
      Networking • Operating Systems • Nmap • Ethical Hacking • Python
    </p>

  </section>

  <!-- SKILLS -->
  <section id="skills" class="py-24 px-6 bg-black">
    <h2 class="text-4xl font-bold text-center mb-16 
               text-purple-400 
               drop-shadow-[0_0_15px_rgba(168,85,247,0.8)]">
      Skills
    </h2>

    <div class="grid md:grid-cols-3 gap-10 max-w-6xl mx-auto">

      <!-- Security Tools -->
      <div onclick="this.classList.toggle('scale-125')"
           class="bg-black border border-purple-500/30
                  p-8 rounded-2xl text-center
                  hover:scale-110
                  transition duration-300 cursor-pointer
                  hover:shadow-[0_0_40px_rgba(168,85,247,0.7)]">

        <h3 class="text-2xl font-semibold mb-4 text-purple-300">
          Tools
        </h3>
        <p class="text-gray-400 text-sm">
          Nmap • Wireshark • Metasploit • Burp Suite • Hydra
        </p>
      </div>

      <!-- Concepts -->
      <div onclick="this.classList.toggle('scale-125')"
           class="bg-black border border-purple-500/30
                  p-8 rounded-2xl text-center
                  hover:scale-110
                  transition duration-300 cursor-pointer
                  hover:shadow-[0_0_40px_rgba(168,85,247,0.7)]">

        <h3 class="text-2xl font-semibold mb-4 text-purple-300">
          Concepts
        </h3>
        <p class="text-gray-400 text-sm">
          TCP/IP • OSI Model • DNS • Subnetting • Web Security Basics
        </p>
      </div>

      <!-- Programming -->
      <div onclick="this.classList.toggle('scale-125')"
           class="bg-black border border-purple-500/30
                  p-8 rounded-2xl text-center
                  hover:scale-110
                  transition duration-300 cursor-pointer
                  hover:shadow-[0_0_40px_rgba(168,85,247,0.7)]">

        <h3 class="text-2xl font-semibold mb-4 text-purple-300">
          Programming
        </h3>
        <p class="text-gray-400 text-sm">
         Python • Bash • Flask • Git • HTML • CSS • Javascript 
        </p>
      </div>

    </div>
  </section>

  <!-- PROJECTS -->
<section id="projects" class="py-24 px-6 bg-gray-950 relative z-0">
  <h2 class="text-4xl font-bold text-center mb-16 text-purple-400">
    Projects
  </h2>

  <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto">

    <!-- Project 1 -->
    <div
      class="project-card bg-black border border-purple-500/30 p-8 rounded-2xl hover:scale-105 transition cursor-pointer hover:shadow-[0_0_40px_rgba(168,85,247,0.7)]"
      data-title="Phishing Detection System"
      data-desc="About
A machine learning–based phishing email detection system with cybersecurity-oriented enhancements, including explainability, threat categorization, emotional manipulation analysis, and rule-based attack detection."
      data-link="https://github.com/mithra916/Phishing-email-detection"
    >
      <h3 class="text-xl font-semibold mb-3 text-purple-300">
        Phishing Detection System
      </h3>
      <p class="text-gray-400 text-sm">
        About
	A machine learning–based phishing email detection system with cybersecurity-oriented enhancements, including explainability, threat categorization, emotional manipulation analysis, and rule-based attack detection.
      </p>
    </div>

    <!-- Project 2 -->
    <div
      class="project-card bg-black border border-purple-500/30 p-8 rounded-2xl hover:scale-105 transition cursor-pointer hover:shadow-[0_0_40px_rgba(168,85,247,0.7)]"
      data-title="Quish Guard AI"
      data-desc="Quish-Guard AI is a real-time, zero-click security tool designed to detect and block QR code phishing (Quishing) attempts. Unlike traditional scanners that only check the URL text, Quish-Guard employs a 4-Layer Defense-in-Depth Engine to analyze the infrastructure, encryption, and behavior behind the link before the user visits it."
      data-link="https://github.com/santhoshr-15/quish-guard-ai"
    >
      <h3 class="text-xl font-semibold mb-3 text-purple-300">
        Quish Guard AI
      </h3>
      <p class="text-gray-400 text-sm">
        Quish-Guard AI is a real-time, zero-click security tool designed to detect and block QR code phishing (Quishing) attempts. Unlike traditional scanners that only check the URL text, Quish-Guard employs a 4-Layer Defense-in-Depth Engine to analyze the infrastructure, encryption, and behavior behind the link before the user visits it.
      </p>
    </div>

  </div>

  <!-- PROJECT MODAL -->
  <div id="project-modal"
       class="fixed inset-0 bg-black/80 backdrop-blur-md flex items-center justify-center p-6 opacity-0 pointer-events-none transition-opacity duration-300 z-50">

    <div class="bg-black/90 border border-purple-500/30 rounded-3xl p-10 max-w-xl w-full text-center relative">

      <span id="project-close"
            class="absolute top-4 right-6 text-gray-400 text-2xl cursor-pointer hover:text-purple-400">
        &times;
      </span>

      <h3 id="project-title"
          class="text-3xl font-bold mb-6 text-purple-300">
      </h3>

      <p id="project-desc"
         class="text-gray-400 text-sm mb-6">
      </p>

      <a id="project-link"
         target="_blank"
         rel="noopener noreferrer"
         class="inline-block px-6 py-2 border border-purple-400 text-purple-400 rounded-lg hover:bg-purple-400 hover:text-black transition">
        View on GitHub
      </a>

    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const projectCards = document.querySelectorAll('.project-card');
  const projectModal = document.getElementById('project-modal');
  const projectTitle = document.getElementById('project-title');
  const projectDesc = document.getElementById('project-desc');
  const projectLink = document.getElementById('project-link');
  const projectClose = document.getElementById('project-close');

  projectCards.forEach(card => {
    card.addEventListener('click', () => {
      projectTitle.textContent = card.dataset.title;
      projectDesc.textContent = card.dataset.desc;
      projectLink.href = card.dataset.link;

      projectModal.classList.remove('opacity-0','pointer-events-none');
      projectModal.classList.add('opacity-100','pointer-events-auto');
    });
  });

  projectClose.addEventListener('click', () => {
    projectModal.classList.add('opacity-0','pointer-events-none');
    projectModal.classList.remove('opacity-100','pointer-events-auto');
  });

  projectModal.addEventListener('click', e => {
    if(e.target === projectModal){
      projectModal.classList.add('opacity-0','pointer-events-none');
      projectModal.classList.remove('opacity-100','pointer-events-auto');
    }
  });

});
</script>

  <!-- CONTACT -->
<section id="contact" class="py-24 bg-black text-center px-6">
  <h2 class="text-4xl font-bold mb-10 text-purple-400">
    Contact
  </h2>

  <p class="text-gray-400 mb-10">
    Open to Cyber Security Roles & Internships
  </p>

  <div class="flex justify-center gap-12 flex-wrap">

    <!-- Email -->
    <a href="mailto: logamithra09@gmail.com"
       class="group flex flex-col items-center text-gray-400 hover:text-purple-400 transition">

      <svg xmlns="http://www.w3.org/2000/svg"
           class="w-8 h-8 mb-2 group-hover:scale-110 transition"
           fill="none"
           viewBox="0 0 24 24"
           stroke="currentColor"
           stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 8l9 6 9-6M4 6h16a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2z"/>
      </svg>

      <span class="text-sm">Email</span>
    </a>

    <!-- GitHub -->
    <a href="https://github.com/mithra916"
       target="_blank"
       rel="noopener noreferrer"
       class="group flex flex-col items-center text-gray-400 hover:text-purple-400 transition">

      <svg xmlns="http://www.w3.org/2000/svg"
           class="w-8 h-8 mb-2 group-hover:scale-110 transition"
           fill="currentColor"
           viewBox="0 0 24 24">
        <path d="M12 0C5.37 0 0 5.37 0 12a12 12 0 008.2 11.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016 0C17 4.84 18 5.16 18 5.16c.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.93.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>

      <span class="text-sm">GitHub</span>
    </a>

    <!-- LinkedIn -->
    <a href="https://www.linkedin.com/in/logamithra916"
       target="_blank"
       rel="noopener noreferrer"
       class="group flex flex-col items-center text-gray-400 hover:text-purple-400 transition">

      <svg xmlns="http://www.w3.org/2000/svg"
           class="w-8 h-8 mb-2 group-hover:scale-110 transition"
           fill="currentColor"
           viewBox="0 0 24 24">
        <path d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6S0 4.88 0 3.5 1.11 1 2.49 1s2.49 1.12 2.49 2.5zM.24 8.98h4.5V24H.24zM7.98 8.98h4.32v2.05h.06c.6-1.13 2.07-2.32 4.26-2.32 4.55 0 5.39 2.99 5.39 6.88V24h-4.5v-6.97c0-1.66-.03-3.79-2.31-3.79-2.31 0-2.67 1.8-2.67 3.67V24h-4.5z"/>
      </svg>

      <span class="text-sm">LinkedIn</span>
    </a>

  </div>
</section>
</Layout>